class Solution {
    public int[] findDiagonalOrder(int[][] mat) {
        
        int n = mat.length, m = mat[0].length;
        if(mat == null || mat.length == 0){
            return new int[0];
        }

        int res[] = new int[n * m];
        int col = 0,row = 0,dir = 1; //dir = 1 measn moving up and 1 means moving down
        for(int i = 0; i < n * m;i++){
            res[i] = mat[row][col];

            if(dir == 1){

                if(col == m-1){
                    row++;
                    dir = -1;
                }else if(row == 0){
                    col++;
                    dir = -1;
                }else{
                    row--;
                    col++;
                }
            }else{
                if(row == n-1){
                    col++;
                    dir = 1;
                }else if(col == 0){
                    row++;
                    dir = 1;
                }else{
                    col--;
                    row++;
                }
            }


        }
        return res;
    }
}


Given an m x n matrix mat, return an array of all the elements of the array in a diagonal order.
Example 1:


Input: mat = [[1,2,3],[4,5,6],[7,8,9]]
Output: [1,2,4,7,5,3,6,8,9]

T.C => O(n * M)
S.C => O(1)
