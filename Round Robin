import java.util.* ;
import java.io.*; 
import java.util.ArrayList;

public class Solution {

	public static ArrayList<Integer> roundRobin(ArrayList<Integer> process, int n, int quantum) {
		// Write your code here.

		ArrayList<Integer> waiting = new ArrayList<>();

		int rem[] = new int[n];
		int com[] = new int[n];

		Queue<Integer> q = new LinkedList<>();

		for(int i = 0; i < n;i++){
			rem[i] = process.get(i);
		}

		for(int i = 0; i < n; i++){
			q.add(i);
		}

		int time = 0;
		while(!q.isEmpty()){
			int i = q.poll();

			int exec = Math.min(quantum,rem[i]);

			time += exec;
			rem[i] -= exec;

			if(rem[i] > 0){
				q.add(i);
			}else{
				com[i] = time;
			}
		}

		for(int i = 0; i < n; i++){
			int wait = com[i] - process.get(i);
			waiting.add(wait);
		}
		return waiting;
	}
	
}
