class Sorting{
    public static void main(String[] args) {
        int arr[] = {3,5,9,2,1,6};
        quickSort(arr, 0, arr.length-1);
        printArr(arr);
    }

    public static void quickSort(int arr[],int si,int ei) {
        if(si >= ei){
            return;
        }
        int piv_idx = partition(arr,si,ei);
        quickSort(arr, si, piv_idx-1);
        quickSort(arr, piv_idx+1, ei);
    }
   public static int partition(int arr[],int si,int ei) {
    int pivot = arr[ei];  //last ele picked as pivot
    int i = si-1;  //start iterator with -1

    for(int j = si;j < ei;j++){  //picked small ele in left handside
        if(arr[j] <= pivot){
            i++;

            //swap
            int temp = arr[j];
            arr[j] = arr[i];
            arr[i] = temp;
        }
    }

        i++;        //placed pivot at its correct position 
         int temp = pivot;
            arr[ei] = arr[i];
            arr[i] = temp;

    
    return i;

}

    public static void printArr(int  arr[]) {
        for (int i = 0; i < arr.length; i++) {
            System.out.print(arr[i]+" ");
        }
    }



}
