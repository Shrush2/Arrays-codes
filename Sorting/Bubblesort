
class Main {
    public static void main(String[] args) {
int[] arr = { 64, 25, 12, 22, 11 };
         SelectionSort(arr);
         printArray(arr);
    }
    
    public static void SelectionSort(int arr[]){
        int n = arr.length;
        for(int i=0 ; i< n-1; i++){
            
            for(int j = 0 ; j < n-i-1 ;j++){
                if(arr[j+1] < arr[j]){
                    int temp = arr[j];
                 arr[j] = arr[j+1];
                 arr[j+1] = temp;
                }
                
            }
        
           
        
    }
    }
     public static void printArray(int[] arr){
        for (int val : arr) {
            System.out.print(val + " ");
        }
        System.out.println();
    }
}
