class Solution {
    public void merge(int[] nums1, int m, int[] nums2, int n) {
        ArrayList<Integer> l1 =  new ArrayList<>();
        ArrayList <Integer> l2 = new ArrayList<>();

        for(int i =0;i<m;i++){
            l1.add(nums1[i]);
        }
        for(int i=0;i<n;i++){
            l2.add(nums2[i]);
        }

        l1.addAll(l2);

        Collections.sort(l1);
        for(int i =0;i < l1.size();i++){
            nums1[i] = l1.get(i);
            System.out.print(l1.get(i) +" ");
        }

        for(int i =0;i < m;i++){
            System.out.print(nums1[i] +" ");
        }
        
    }
}

