import java.util.*;
public class Solution {
    public static List< Integer > sortedArray(int []a, int []b) {

        int n = a.length;
        int m = b.length;

        Set<Integer> s1  = new HashSet<>();
         ArrayList<Integer> l1  = new ArrayList<>();

         for(int i=0;i<n;i++){
             s1.add(a[i]);
         }

         for(int i=0;i<m;i++){
             s1.add(b[i]);
         }

        for(int s: s1){
            l1.add(s);
        }
        Collections.sort(l1);

        
        return l1;


    }
}
