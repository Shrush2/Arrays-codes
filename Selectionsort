

class Main {
    public static void main(String[] args) {
int[] arr = { 64, 25, 12, 22, 11 };
         SelectionSort(arr);
         printArray(arr);
    }
    
    public static void SelectionSort(int arr[]){
        int n = arr.length;
        for(int i=0 ; i< n-1; i++){
            int min_indx = i;
            
            for(int j = i+1; j<n ;j++){
                if(arr[j] < arr[min_indx]){
                    min_indx = j;
                }
                
            }
        
            int temp = arr[i];
            arr[i] = arr[min_indx];
            arr[min_indx] = temp;
        
    }
    }
     public static void printArray(int[] arr){
        for (int val : arr) {
            System.out.print(val + " ");
        }
        System.out.println();
    }
}
