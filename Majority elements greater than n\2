class Solution {
    public int majorityElement(int[] v) {
        int el =0;
        int cnt = 0;
        int n = v.length;

        for(int i=0;i<n;i++){
            if(cnt == 0){
                cnt = 1;
                el = v[i];
            }else if(el == v[i]){
                cnt++;
            }else{
                cnt--;
            }
        }

        cnt = 0;
        for(int i=0;i<n;i++){
            if(el == v[i]){
                cnt++;
            }
        }
        if(cnt > n/2){
            return el;
        }
        return -1;
    }
}
