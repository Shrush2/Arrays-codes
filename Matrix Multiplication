import java.util.* ;
import java.io.*; 
import java.util.ArrayList;

public class Solution {
    public static ArrayList<ArrayList<Integer>> multiplyMatrices(ArrayList<ArrayList<Integer>> mat1, ArrayList<ArrayList<Integer>> mat2) {

        int n1 = mat1.size();
        int m1 = mat1.get(0).size();
        int n2 = mat2.size();
        int m2 = mat2.get(0).size();

        ArrayList<ArrayList<Integer>> res = new ArrayList<>();


         for(int i = 0; i < n1; i++){
             ArrayList<Integer> row = new ArrayList<>(Collections.nCopies(m2,0));
             res.add(row);
         }

         for(int i = 0; i < n1; i++){
             for(int j = 0; j < m2; j++){
                 int sum = 0;

                 for(int k = 0; k < m1; k++){
                     sum = sum + (mat1.get(i).get(k) * mat2.get(k).get(j));
            
                 }
                 res.get(i).set(j,sum);
             }
         }
         return res;
    }
    
}


