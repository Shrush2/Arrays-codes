import java.util.*;
class Solution {
    public int[] intersection(int[] nums1, int[] nums2) {
        int i=0,j=0,k=0;
        int n = nums1.length, m = nums2.length;
        int min = Math.min(n,m);

        Arrays.sort(nums1);// Sorting ensures correct two-pointer approach
        Arrays.sort(nums2);

         int ans[] = new int[min];
        while(i < n && j < m){
            if(nums1[i] < nums2[j]){
                i++;
            }else if(nums2[j] < nums1[i]){
                j++;
            }else{
                if(k == 0 || ans[k-1] != nums1[i]){ //Avoid duplicates
                ans[k++] = nums1[i];
                }
                i++;
                j++;
                
            }
        }
        return Arrays.copyOf(ans,k); // creates a new array that contains only the first k elements of ans
    }
}
