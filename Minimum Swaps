import java.util.* ;
import java.io.*; 
import java.util.ArrayList;

public class Solution 
{
    public static int minimumSwaps(ArrayList<Integer> arr, int n, int k) 
    {
        // Write your code here.

        int goodcnt = 0;
        for(int i = 0; i < n; i++){
            if(arr.get(i) <= k){
                goodcnt++;
            }
        }

        if(goodcnt == 0 || goodcnt == n){
            return 0;
        }

        int badcnt = 0;
        for(int i = 0; i < goodcnt; i++){
            if(arr.get(i) > k){
                badcnt++;
            }
        }

        int minSwaps = Integer.MAX_VALUE;
        minSwaps = badcnt;

        int start = 0;
        for(int end = goodcnt; end < n; end++){
            if(arr.get(start) > k){
                badcnt--;
            }

            if(arr.get(end) > k){
                badcnt++;
            }
                    minSwaps  = Math.min(minSwaps,badcnt);
                start++;
        }
        return minSwaps; 
    }
}


