import java.util.* ;
import java.io.*; 
public class Solution {
	public static int[] anagramMapping(int n, int[] a, int[] b) {

		HashMap<Integer,Integer> map = new HashMap<>();
		int arr[] = new int[a.length];
		
		for(int i = 0; i < b.length;i++){
			map.put(b[i],i);
		}

		for(int i = 0; i < b.length;i++){
			arr[i] = map.get(a[i]);
		}
		return arr;
	}
} 


