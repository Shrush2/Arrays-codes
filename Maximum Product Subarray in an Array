import java.util.*;
public class Solution {
    public static int subarrayWithMaxProduct(int []arr){
        // Write your code here.
        int ans = Integer.MIN_VALUE;
        int n = arr.length;
        int prefix = 1, suffix = 1;


        for(int i = 0;i < n; i++){
           if(prefix == 0){
               prefix = 1;
           }
           if(suffix == 0){
               suffix = 1;
           }
        prefix = prefix * arr[i];
        suffix = suffix * arr[n-i-1];
        
        ans = Math.max(ans,Math.max(prefix,suffix));
           
        }
        return ans;
    }
}
