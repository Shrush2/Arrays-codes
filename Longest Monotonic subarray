class Solution {
    public int longestMonotonicSubarray(int[] nums) {
        int currInc = 1;
        int currDec = 1;
        int maxlen = 1;
        int n = nums.length;

        for(int i =1 ;i < n;i++ ){
            if(nums[i] < nums[i-1]){
                currDec++;
                currInc = 1;

            }
            else if(nums[i] > nums[i-1]){
                currDec = 1;
                currInc++;

            }else{
                 currDec = 1;
                currInc = 1;

            }
              maxlen = Math.max(maxlen,Math.max(currInc,currDec));

        }
        return maxlen;
    }
}
