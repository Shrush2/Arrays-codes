import java.util.* ;
import java.io.*; 

public class Solution {
	
	public static long maxSubarraySum(int[] arr, int n) {
        long sum = 0;
        long max = Long.MIN_VALUE;
        boolean has_positive = false;

        if(n == 0) return 0;
        for(int i=0;i<n;i++){
            sum += arr[i];

            max = Math.max(sum,max);

            if(sum < 0){
                sum =0;
            }

            if(arr[i] >= 0){
                has_positive = true;
            }
        }
        return has_positive ? max : 0;

	}

}
