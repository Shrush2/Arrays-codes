class Solution {
    public long countBadPairs(int[] nums) {
        int n = nums.length;
        Map<Integer,Integer> map = new HashMap<>();
        long totalpairs = (long)n*(n-1)/2;
        long goodpairs = 0;
        

        for(int j = 0;j < n;j++){
            int key = nums[j]-j;
           goodpairs += map.getOrDefault(key,0);
           map.put(key,map.getOrDefault(key,0)+1);
            }
        
        return totalpairs-goodpairs;
    }
}
