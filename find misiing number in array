public class Solution {
    public static int missingNumber(int []a, int N) {
        int n= N-1;
        int xor1=0;
        int xor2=0;
        for(int i=0;i<n;i++){
            xor1 = xor1^i+1;
            xor2 = xor2^a[i];
        }
        xor1 = xor1^N;
        return xor1^xor2;
       
    }
}
