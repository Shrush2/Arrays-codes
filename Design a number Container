class NumberContainers {
    private Map<Integer,Integer> indexToNumber;
    private Map<Integer,TreeSet<Integer>> numberToindx;


    public NumberContainers() {
        indexToNumber = new HashMap<>();
        numberToindx = new HashMap<>();
    }
    
    public void change(int index, int number) {
        if(indexToNumber.containsKey(index)){
            int oldnum = indexToNumber.get(index);
            if(oldnum != number){
                numberToindx.get(oldnum).remove(index);

                if(numberToindx.get(oldnum).isEmpty()){
                    numberToindx.remove(oldnum);
                }
            }
        }

        indexToNumber.put(index,number);
        numberToindx.putIfAbsent(number,new TreeSet<>());
        numberToindx.get(number).add(index);
    }
    
    public int find(int number) {
        if(!numberToindx.containsKey(number) || numberToindx.get(number).isEmpty()){
            return -1;
        }
        return numberToindx.get(number).first();
    }
}

