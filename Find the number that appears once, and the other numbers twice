class Solution {
    public int singleNumber(int[] arr) {
        int n = arr.length;

        if(n == 0){
            return -1;
        }

        HashMap<Integer,Integer> mpp = new HashMap<>();
        for(int num : arr){
            mpp.put(num,mpp.getOrDefault(num,0)+1);
        }

        for(int num : arr){
            if(mpp.get(num) == 1){
                return num;
            }
        }

        return -1;
    }
}

-----------------OPTIMAL APPROACH------------------
public class Solution {
    public static int getSingleElement(int []arr){
        int n=arr.length;
        int xor=0;
        for(int i=0;i<n;i++){
            xor = xor ^ arr[i];
        }
    
        return xor;

    }
}
