import java.util.* ;
import java.io.*; 
public class Solution {
    public static double calculateArea(int n, int points[][]) {
        // Write your code here.
        double maxArea = 0.0;
        for(int i = 0; i < n;i++){
            for(int j = i+1; j < n;j++){
                for(int k = j+1 ; k < n;k++){
                   double curr = area(points[i] , points[j] , points[k]);

                    if(curr > maxArea){
                        maxArea = curr;
                    }
                }
            }
        }
        return maxArea;
    }

    public static double area(int p1[],int p2[],int p3[]){
        return Math.abs(
            p1[0] * (p2[1] - p3[1]) +
            p2[0] * (p3[1] - p1[1]) +
            p3[0] * (p1[1] - p2[1])
            ) / 2.0;
    }
}


